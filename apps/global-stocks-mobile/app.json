{
  "expo": {
    "name": "Global Stock",
    "slug": "global-stocks",
    "scheme": "globalstocks",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.globalstocks.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Global Stock usa la cámara para identificar códigos de barras y QR de productos.",
        "UIUserInterfaceStyle": "Dark"
      },
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "app.globalstocks.mobile",
      "permissions": [
        "CAMERA"
      ],
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#09090C"
      },
      "userInterfaceStyle": "dark"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Global Stock necesita la cámara para escanear productos.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090C",
          "image": "./assets/splash.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#09090C",
            "image": "./assets/splash.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d3f33419-261b-4615-818d-f6802350b085"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090C"
    },
    "backgroundColor": "#09090C",
    "web": {
      "name": "Global Stock",
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/native-app"
    }
  }
}

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SYNC_WEBHOOK_SECRET=

# Cloudflare Turnstile PUBLIC site key, safe for NEXT_PUBLIC_ usage.
# Keep Supabase CAPTCHA turned OFF until /auth/turnstile, web and Expo Go
# sign-in/sign-up have been tested with this key and the matching secret.
# The private Cloudflare Secret Key belongs ONLY in Supabase Auth protection,
# never in this file, NEXT_PUBLIC_* variables or GitHub.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Global Intelligence — Gemini primary provider when both variables are set.
# Keep the API key server-side. Never expose it with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional endpoint override. Leave blank to use Google Generative Language API.
GEMINI_API_URL=

# OpenAI-compatible fallback configuration. Used only when Gemini is not configured.
# Keep the key server-side. Never expose it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional generic/OpenAI-compatible override.
# If OPENAI_API_KEY is set and AI_API_URL is blank, Global Stock uses
# https://api.openai.com/v1/chat/completions automatically.
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Encrypts verified store connector tokens in HttpOnly cookies.
# Production: use a random secret with at least 32 characters.
GLOBAL_STOCK_CONNECTOR_SECRET=

# Store listing links. Leave blank until the listing is actually published.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_MICROSOFT_STORE_URL=
NEXT_PUBLIC_APP_GALLERY_URL=
NEXT_PUBLIC_GALAXY_STORE_URL=

# Ecommerce provider apps. These are server-only.
# Register the Global Stock app in each provider before filling them.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=

# WooCommerce credentials are created per store. This flag only enables
# the connector UI after the server-side WooCommerce flow is configured.
WOOCOMMERCE_INTEGRATION_ENABLED=false

# Optional public app URL used to build OAuth callback URLs after deployment.
NEXT_PUBLIC_APP_URL=


# Argentina fiscal invoicing (ARCA) through a real fiscal provider/adapter.
# Leave these blank until production credentials are available.
# While blank, Global Stock keeps fiscal documents as drafts and never invents
# CAE/authorization codes, official numbering or QR data.
ARCA_FISCAL_PROVIDER_URL=
ARCA_FISCAL_PROVIDER_API_KEY=
ARCA_FISCAL_PROVIDER_TIMEOUT_MS=15000

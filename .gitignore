*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Protect ALL workspaces (Flutter, Next.js, Expo) from local secrets and build junk.
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/node_modules/
**/.next/
**/.expo/
**/.vercel/
**/dist/
**/web-build/
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.jks
**/*.keystore
**/*.mobileprovision
**/*.cer
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# An independent Expo starter created locally. Preserve it on disk but do not
# accidentally include it in the Global Stock application repository.
/mi-app/

# Playwright's generated HTML reports, screenshots, traces and run state.
/playwright-report/
/test-results/
